---
/**
 * Layout base: <html lang>, <head> SEO/OG completo, header y footer.
 * Recibe el idioma y la ruta localizada se infiere de la URL en build.
 */
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { t, translatePath } from '../i18n/ui';
import { contentFor } from '../data';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang } = Astro.props;
const c = contentFor(lang);
const title = Astro.props.title ?? c.meta.title;
const description = Astro.props.description ?? c.meta.description;
const { pathname } = Astro.url;
const esPath = translatePath(pathname, lang, 'es');
const enPath = translatePath(pathname, lang, 'en');
const isEn = lang === 'en';
const canonical = new URL(pathname, Astro.site);
const siteName = t(lang, 'site.name');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Aplica el tema guardado antes de pintar (evita parpadeo).
      (function () {
        try {
          var t = localStorage.getItem('pixel-theme');
          if (t !== 'dark' && t !== 'light') {
            t =
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07070d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'es_ES'} />
    <meta property="og:locale:alternate" content={isEn ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={new URL('/favicon.svg', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <noscript><style>[data-reveal],[data-stagger]>*{opacity:1!important;transform:none!important;filter:none!important}</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t(lang, 'skip.to-content')}</a>
    <Header lang={lang} pathname={pathname} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // Reveal on-scroll estilo Framer Motion (whileInView, una vez, 60fps).
      (function () {
        var sel = '[data-reveal],[data-stagger]';
        var els = document.querySelectorAll(sel);
        if (!('IntersectionObserver' in window) || !els.length) {
          document.querySelectorAll(sel).forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var force = /[?&]motion=force/.test(window.location.search);
        var reduce = !force && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                var el = e.target;
                io.unobserve(el);
                var d = el.getAttribute('data-delay');
                if (d) el.style.setProperty('--reveal-delay', d + 'ms');
                // Doble rAF: pinta el estado inicial antes de transicionar
                requestAnimationFrame(function () {
                  requestAnimationFrame(function () {
                    el.classList.add('is-visible');
                  });
                });
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
