---
/**
 * Footer de sitio completo: marca, navegación, servicios, contacto y legal.
 */
import type { Lang } from '../i18n/ui';
import { t, pageHref } from '../i18n/ui';
import { contentFor, CONTACT, SOCIALS, SITE_NAME } from '../data';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = contentFor(lang);
const year = new Date().getFullYear();

const navLinks = [
  { label: t(lang, 'nav.home'), href: pageHref(lang, 'home') },
  { label: t(lang, 'nav.services'), href: pageHref(lang, 'services') },
  { label: t(lang, 'nav.about'), href: pageHref(lang, 'about') },
  { label: t(lang, 'nav.blog'), href: pageHref(lang, 'blog') },
  { label: t(lang, 'nav.contact'), href: pageHref(lang, 'contact') },
];

const contactRows = [
  { label: t(lang, 'footer.email'), value: CONTACT.email, href: `mailto:${CONTACT.email}` },
  { label: t(lang, 'footer.whatsapp'), value: CONTACT.whatsapp, href: '' },
  { label: t(lang, 'footer.location'), value: CONTACT.location, href: '' },
] as const;
---
<footer class="footer">
  <div class="footer__ascii-bg" aria-hidden="true" data-footer-ascii>
    <canvas data-footer-ascii-canvas class="footer-ascii-canvas"></canvas>
  </div>
  <div class="container">
    <div class="footer__grid" data-reveal>
      <div class="footer__brand">
        <a class="brand" href={pageHref(lang, 'home')} aria-label={SITE_NAME}>
          <img class="brand__logo" src="/favicon.svg" width="34" height="34" alt="" aria-hidden="true" />
          <span>{SITE_NAME}</span>
        </a>
        <p class="footer__about" style="margin-top: 18px;">
          {c.shared.footerTagline}
        </p>
        <p class="footer__about" style="margin-top: 10px;">
          {c.shared.footerAbout}
        </p>
        <nav class="footer__social" aria-label={t(lang, 'footer.social')}>
          {
            SOCIALS.map((s) => (
              <a class="chip" href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
                <Icon name="external" />
              </a>
            ))
          }
        </nav>
      </div>

      <nav aria-label={t(lang, 'footer.nav')}>
        <h4>{t(lang, 'footer.nav')}</h4>
        <ul role="list">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t(lang, 'footer.services')}>
        <h4>{t(lang, 'footer.services')}</h4>
        <ul role="list">
          {
            c.home.services.items.map((s) => (
              <li>
                <a href={s.href}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h4>{t(lang, 'footer.contact')}</h4>
        <ul class="footer__contact" role="list">
          {
            contactRows.map((row) => (
              <li>
                <span class="mono">{row.label}</span>
                {row.href ? <a href={row.href}>{row.value}</a> : <span>{row.value}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>
        © {year} {SITE_NAME}. {t(lang, 'footer.rights')}
      </p>
    </div>
  </div>
</footer>

<script>
  // Matrix Cyberpunk Decode Effect renderizado en HTML5 Canvas (100% fluido y responsivo)
  if (typeof window !== 'undefined') {
    const initFooterCanvas = () => {
      const container = document.querySelector<HTMLElement>('[data-footer-ascii]');
      const canvas = document.querySelector<HTMLCanvasElement>('[data-footer-ascii-canvas]');
      if (!container || !canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const desktopLines = [
        "░▒▓███████▓▒░░▒▓████████▓▒░░▒▓███████▓▒░▒▓█▓▒░▒▓███████▓▒░ ░▒▓██████▓▒░       ░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓████████▓▒░▒▓███████▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░      ░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░      ░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░             ░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓██████▓▒░  ░▒▓██████▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒▒▓███▓▒░      ░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓██████▓▒░ ░▒▓███████▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░             ░▒▓█▓▒░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░             ░▒▓█▓▒░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓███████▓▒░░▒▓████████▓▒░▒▓███████▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░░▒▓██████▓▒░        ░▒▓█████████████▓▒░░▒▓████████▓▒░▒▓███████▓▒░"
      ];

      const mobileLines = [
        "░▒▓███████▓▒░░▒▓████████▓▒░░▒▓███████▓▒░▒▓█▓▒░▒▓███████▓▒░░▒▓██████▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░      ░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓██████▓▒░ ░▒▓██████▓▒░ ░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░            ░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓███████▓▒░░▒▓████████▓▒░▒▓███████▓▒░░▒▓█▓▒░▒▓█▓▒░░▒▓█▓▒░░▒▓██████▓▒░",
        "",
        "░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓████████▓▒░▒▓███████▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓██████▓▒░ ░▒▓███████▓▒░",
        "░▒▓█▓▒░░▒▓█▓▒░░▒▓█▓▒░▒▓█▓▒░      ░▒▓█▓▒░░▒▓█▓▒░",
        "░▒▓█████████████▓▒░░▒▓████████▓▒░▒▓███████▓▒░"
      ];

      const glitchedChars = '░▒▓██01_<>[]/*#@%&$!▓▒░█';
      let hasAnimated = false;

      const renderCanvas = (progress = 1) => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = container.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;

        if (!width || !height) return;

        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.clearRect(0, 0, width, height);

        const isMobile = width < 768;
        const targetLines = isMobile ? mobileLines : desktopLines;
        const maxCols = Math.max(...targetLines.map((l) => l.length));

        const fontPadding = isMobile ? 12 : 36;
        const availableWidth = Math.max(100, width - fontPadding * 2);

        // En canvas la tipografía mono mide aprox 0.60em por carácter
        const fontSize = Math.max(5, Math.min(isMobile ? 15 : 28, availableWidth / (maxCols * 0.60)));
        ctx.font = `700 ${fontSize}px 'JetBrains Mono', 'Courier New', monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        const theme = document.documentElement.getAttribute('data-theme');
        const textColor = theme === 'light' ? 'rgba(0, 0, 0, 0.12)' : 'rgba(244, 244, 245, 0.16)';
        const glitchColor = theme === 'light' ? 'rgba(83, 61, 240, 0.25)' : 'rgba(229, 229, 229, 0.38)';

        ctx.fillStyle = progress < 1 ? glitchColor : textColor;

        const lineGap = fontSize * (isMobile ? 1.25 : 1.15);
        const totalHeight = targetLines.length * lineGap;
        const startY = (height - totalHeight) / 2 + lineGap / 2;

        targetLines.forEach((line, rowIndex) => {
          let lineToDraw = line;

          if (progress < 1 && line.trim().length > 0) {
            lineToDraw = line
              .split('')
              .map((char, colIndex) => {
                if (char === ' ') return ' ';
                const charProgress = colIndex / maxCols;
                if (progress > charProgress + 0.3) {
                  return char;
                } else if (progress > charProgress - 0.1) {
                  return glitchedChars[Math.floor(Math.random() * glitchedChars.length)];
                } else {
                  return ' ';
                }
              })
              .join('');
          }

          const yPos = startY + rowIndex * lineGap;
          ctx.fillText(lineToDraw, width / 2, yPos);
        });

        ctx.restore();
      };

      const startDecodeAnimation = () => {
        if (hasAnimated) return;
        hasAnimated = true;

        let frame = 0;
        const totalFrames = 46;

        const interval = setInterval(() => {
          frame++;
          const progress = frame / totalFrames;
          renderCanvas(progress);

          if (frame >= totalFrames) {
            clearInterval(interval);
            renderCanvas(1);
          }
        }, 30);
      };

      let resizeTimer: number;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => renderCanvas(1), 80);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startDecodeAnimation();
              observer.disconnect();
            }
          });
        },
        { threshold: 0.1 }
      );

      observer.observe(container);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterCanvas);
    } else {
      initFooterCanvas();
    }
  }
</script>
