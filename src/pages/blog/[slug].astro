---
// /blog/[slug] (español).
import { getPosts, getPost } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostPage from '../../components/pages/BlogPostPage.astro';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  return posts.map((post) => ({ params: { slug: post.cleanSlug } }));
}

const post = await getPost('es', Astro.params.slug!);
---

<BaseLayout
  lang="es"
  title={post ? `${post.data.title} · Pixel Web` : undefined}
  description={post?.data.description}
>
  <BlogPostPage lang="es" slug={Astro.params.slug!} />
</BaseLayout>
