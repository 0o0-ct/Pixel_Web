---
/**
 * Layout base: <html lang>, <head> SEO/OG completo, header y footer.
 * Recibe el idioma y la ruta localizada se infiere de la URL en build.
 */
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { t, translatePath } from '../i18n/ui';
import { contentFor } from '../data';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang } = Astro.props;
const c = contentFor(lang);
const title = Astro.props.title ?? c.meta.title;
const description = Astro.props.description ?? c.meta.description;
const { pathname } = Astro.url;
const esPath = translatePath(pathname, lang, 'es');
const enPath = translatePath(pathname, lang, 'en');
const isEn = lang === 'en';
const canonical = new URL(pathname, Astro.site);
const siteName = t(lang, 'site.name');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Aplica el tema guardado antes de pintar (evita parpadeo).
      (function () {
        try {
          var t = localStorage.getItem('pixel-theme');
          if (t !== 'dark' && t !== 'light') {
            t =
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07070d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'es_ES'} />
    <meta property="og:locale:alternate" content={isEn ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={new URL('/favicon.svg', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <noscript><style>[data-reveal],[data-stagger]>*{opacity:1!important;transform:none!important;filter:none!important}</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t(lang, 'skip.to-content')}</a>
    <Header lang={lang} pathname={pathname} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // Bloquea el clic derecho en toda la web.
      document.addEventListener('contextmenu', function (e) {
        e.preventDefault();
      });
    </script>
    <script is:inline>
      // Spotlight global 100% Canvas de altísimo rendimiento
      // 0.0% consumo GPU/CPU en reposo (pausa completa del bucle rAF al estar inactivo o en otra pestaña)
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var root = document.documentElement;
        var PALETTES = {
          dark: ['195,180,255', '255,255,255', '165,145,255'],
          light: ['70,25,225', '15,15,35', '110,20,200'],
        };

        var canvas = document.createElement('canvas');
        canvas.setAttribute('aria-hidden', 'true');
        canvas.style.cssText =
          'position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0;transition:opacity .4s ease;';
        document.body.appendChild(canvas);

        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        var dots = [];
        var mx = -9999;
        var my = -9999;
        var running = true;
        var W = 0;
        var H = 0;
        var rafId = 0;
        var lastMoveAt = 0;

        function stopLoop() {
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
        }

        function build() {
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = window.innerWidth;
          H = window.innerHeight;
          canvas.width = Math.floor(W * dpr);
          canvas.height = Math.floor(H * dpr);
          canvas.style.width = W + 'px';
          canvas.style.height = H + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          var gap = W < 768 ? 24 : 18;
          dots = [];
          for (var y = gap / 2; y < H; y += gap) {
            for (var x = gap / 2; x < W; x += gap) {
              dots.push({
                x: x + (Math.random() - 0.5) * 4,
                y: y + (Math.random() - 0.5) * 4,
                c: (Math.random() * 3) | 0,
                r: 0.8 + Math.random() * 0.5,
              });
            }
          }
        }

        function frame(now) {
          if (!running) return;

          // Reposo: si el ratón lleva inactivo ~1.5s se apaga el canvas y se cancela el bucle rAF (0.0% consumo GPU/CPU)
          if (now - lastMoveAt > 1500) {
            canvas.style.opacity = '0';
            ctx.clearRect(0, 0, W, H);
            stopLoop();
            return;
          }

          var isLight = root.getAttribute('data-theme') === 'light';
          var pal = isLight ? PALETTES.light : PALETTES.dark;
          ctx.clearRect(0, 0, W, H);

          var R = 420;
          var R2 = R * R;

          // Halo suave de resplandor radial estilo Aceternity CardSpotlight directo en Canvas
          var halo = ctx.createRadialGradient(mx, my, 0, mx, my, R);
          if (isLight) {
            halo.addColorStop(0, 'rgba(70, 25, 225, 0.12)');
            halo.addColorStop(0.5, 'rgba(70, 25, 225, 0.04)');
            halo.addColorStop(1, 'rgba(70, 25, 225, 0)');
          } else {
            halo.addColorStop(0, 'rgba(139, 124, 255, 0.16)');
            halo.addColorStop(0.5, 'rgba(99, 102, 241, 0.05)');
            halo.addColorStop(1, 'rgba(139, 124, 255, 0)');
          }
          ctx.beginPath();
          ctx.arc(mx, my, R, 0, 6.2832);
          ctx.fillStyle = halo;
          ctx.fill();

          // Renderizado súper empaquetado: 3 llamadas a ctx.fill() en lugar de 10.000+ (reducción del 99.9% de carga GPU/CPU)
          for (var c = 0; c < 3; c++) {
            ctx.beginPath();
            var count = 0;
            for (var i = 0; i < dots.length; i++) {
              var d = dots[i];
              if (d.c !== c) continue;

              var dx = d.x - mx;
              var dy = d.y - my;
              if (dx > R || dx < -R || dy > R || dy < -R) continue;

              if (dx * dx + dy * dy > R2) continue;

              ctx.moveTo(d.x + d.r, d.y);
              ctx.arc(d.x, d.y, d.r, 0, 6.2832);
              count++;
            }
            if (count > 0) {
              ctx.fillStyle = 'rgba(' + pal[c] + ', 0.85)';
              ctx.fill();
            }
          }

          rafId = requestAnimationFrame(frame);
        }

        function handlePointerMove(e) {
          if (document.hidden) return;
          mx = e.clientX;
          my = e.clientY;

          lastMoveAt = performance.now();
          canvas.style.opacity = '1';

          if (running && !rafId) {
            rafId = requestAnimationFrame(frame);
          }
        }

        document.addEventListener('mousemove', handlePointerMove, { passive: true });
        document.addEventListener('pointermove', handlePointerMove, { passive: true });

        function hideSpotlight() {
          canvas.style.opacity = '0';
          mx = -9999;
          my = -9999;
          stopLoop();
          ctx.clearRect(0, 0, W, H);
        }

        document.addEventListener('mouseleave', hideSpotlight);

        // Al cambiar de pestaña o minimizar el navegador:
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            running = false;
            hideSpotlight();
          } else {
            running = true;
          }
        });

        window.addEventListener('blur', function () {
          hideSpotlight();
        });

        var rt = 0;
        window.addEventListener('resize', function () {
          clearTimeout(rt);
          rt = setTimeout(build, 150);
        });

        build();
      })();
    </script>
    <script is:inline>
      // Reveal on-scroll estilo Framer Motion (whileInView, una vez, 60fps).
      (function () {
        var sel = '[data-reveal],[data-stagger]';
        var els = document.querySelectorAll(sel);
        if (!('IntersectionObserver' in window) || !els.length) {
          document.querySelectorAll(sel).forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var force = /[?&]motion=force/.test(window.location.search);
        var reduce = !force && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        // Modo bucle: al salir de pantalla se oculta y al volver se re-anima.
        // Con data-once se anima una sola vez (como antes).
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              var el = e.target;
              if (e.isIntersecting) {
                var d = el.getAttribute('data-delay');
                if (d) el.style.setProperty('--reveal-delay', d + 'ms');
                // Doble rAF: pinta el estado inicial antes de transicionar
                requestAnimationFrame(function () {
                  requestAnimationFrame(function () {
                    el.classList.add('is-visible');
                  });
                });
                if (el.hasAttribute('data-once')) io.unobserve(el);
              } else if (!el.hasAttribute('data-once')) {
                el.classList.remove('is-visible');
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
