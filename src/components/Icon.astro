---
/**
 * Iconos en línea (estilo feather, trazo 2px) indexados por IconName.
 * Uso: <Icon name="zap" style="color: var(--cyan)" /> — hereda color y
 * tamaño del contexto (currentColor, 1em); reenvía style/class extra.
 */
import type { IconName } from '../data/types';

interface Props {
  name: IconName;
  class?: string;
  'aria-hidden'?: 'true' | 'false';
  style?: string;
}

const { name, class: className = '', 'aria-hidden': ariaHidden = 'true', style } = Astro.props;
const spread = { class: className, style, 'aria-hidden': ariaHidden } as Record<string, unknown>;

