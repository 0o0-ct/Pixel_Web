---
// /en/blog/[slug] (inglés).
import { getPosts, getPost } from '../../../lib/blog';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostPage from '../../../components/pages/BlogPostPage.astro';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return posts.map((post) => ({ params: { slug: post.cleanSlug } }));
}

const post = await getPost('en', Astro.params.slug!);
---

<BaseLayout
  lang="en"
  title={post ? `${post.data.title} · Design Web` : undefined}
  description={post?.data.description}
>
  <BlogPostPage lang="en" slug={Astro.params.slug!} />
</BaseLayout>
