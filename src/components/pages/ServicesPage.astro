---
/**
 * Página de Servicios y Precios — se renderiza para /servicios y /en/services.
 */
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { contentFor } from '../../data';
import type { Plan, ServiceItem } from '../../data';
import Icon from '../Icon.astro';
import PageHeader from '../sections/PageHeader.astro';
import CtaBand from '../sections/CtaBand.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = contentFor(lang).services;
---

<PageHeader eyebrow={s.page.eyebrow} title={s.page.title} lead={s.page.lead} />

<!-- ============ SERVICIOS DETALLADOS ============ -->
<section class="section section--tight">
  <div class="container service-stack" data-stack>
    {
      s.items.map((item: ServiceItem, idx: number) => (
        <div class="stack-track" style={`--i: ${idx}`}>
          <article class="service stack-card" id={item.anchor}>
            <div>
              <div class="service__feature-icon">
                <Icon name={item.icon} />
              </div>
              <h2 class="h-sub" style="font-size: clamp(1.5rem, 2.6vw, 1.9rem);">
                {item.title}
              </h2>
              <p class="lead" style="margin-top: 14px; font-size: 1.02rem;">{item.desc}</p>
              <a class="btn btn-ghost btn-sm" style="margin-top: 26px;" href={item.cta.href}>
                {item.cta.label}
                <Icon name="arrowRight" />
              </a>
            </div>
            <div class="service__panel">
              <ul class="check-list" role="list">
                {item.features.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>
<script>
  import { inView, animate } from 'motion';

  // Framer Motion: Animaciones de entrada (spring), hover interactivo y apilamiento progresivo
  if (typeof window !== 'undefined') {
    const initMotion = () => {
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.stack-card'));
      if (!cards.length) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      cards.forEach((card, index) => {
        // 1. Animación de entrada con Framer Motion inView y física de resorte (spring)
        if (!reduce) {
          inView(
            card,
            () => {
              animate(
                card,
                { opacity: [0, 1], y: [45, 0] },
                {
                  duration: 0.65,
                  delay: index * 0.08,
                  type: 'spring', stiffness: 130, damping: 16
                }
              );
            },
            { amount: 0.2 }
          );
        }

        // 2. Animaciones de gestos / hover interactivo con Framer Motion spring physics
        const icon = card.querySelector<HTMLElement>('.service__feature-icon');

        card.addEventListener('mouseenter', () => {
          if (!reduce) {
            animate(
              card,
              { y: -8 },
              { duration: 0.35, type: 'spring', stiffness: 350, damping: 22 }
            );
            if (icon) {
              animate(
                icon,
                { scale: 1.12, rotate: -4 },
                { duration: 0.35, type: 'spring', stiffness: 400, damping: 18 }
              );
            }
          }
        });

        card.addEventListener('mouseleave', () => {
          if (!reduce) {
            animate(
              card,
              { y: 0 },
              { duration: 0.35, type: 'spring', stiffness: 300, damping: 25 }
            );
            if (icon) {
              animate(
                icon,
                { scale: 1, rotate: 0 },
                { duration: 0.35, type: 'spring', stiffness: 300, damping: 25 }
              );
            }
          }
        });
      });

      // 3. Stacking scroll calculation con escala y brillo suave
      const stack = document.querySelector('[data-stack]');
      if (!stack || reduce) return;

      const small = window.matchMedia('(max-width: 768px)');
      let tops: number[] = [];

      function measure() {
        const base = small.matches ? 72 : 90;
        const step = small.matches ? 12 : 18;
        tops = cards.map((_, i) => base + i * step);
      }

      let ticking = false;
      function update() {
        ticking = false;
        cards.forEach((card, i) => {
          let depth = 0;
          for (let j = i + 1; j < cards.length; j++) {
            if (cards[j].getBoundingClientRect().top <= tops[j] + 2) depth++;
          }
          const scale = Math.max(0.94, 1 - depth * 0.035);
          const brightness = depth > 0 ? (1 - depth * 0.06) : 1;
          card.style.setProperty('--stack-scale', scale.toString());
          card.style.setProperty('--stack-brightness', brightness.toString());
        });
      }

      function request() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      measure();
      update();
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', () => { measure(); request(); });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMotion);
    } else {
      initMotion();
    }
  }
</script>

<!-- ============ PRECIOS ============ -->
<section class="section" id="precios" data-reveal>
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">{s.pricing.eyebrow}</p>
      <h2 class="h-section">{s.pricing.title}</h2>
      <p class="lead" style="margin: 16px auto 0;">{s.pricing.lead}</p>
    </div>

    <div class="pricing-grid" data-stagger>
      {
        s.pricing.plans.map((plan: Plan) => (
          <article class={`card plan${plan.featured ? ' plan--featured' : ''}`}>
            {plan.featured && <span class="plan__badge">{t(lang, 'badge.popular')}</span>}
            <h3 style="font-size: 1.3rem;">{plan.name}</h3>
            <p class="text-muted" style="margin-top: 6px; font-size: 0.92rem;">
              {plan.tagline}
            </p>
            <p class="plan__price" style="margin-top: 22px;">
              {plan.price}
            </p>
            <p class="mono text-faint" style="font-size: 0.78rem;">{plan.priceNote}</p>
            <ul role="list">
              {plan.features.map((f) => <li>{f}</li>)}
            </ul>
            <a
              class={`btn ${plan.featured ? 'btn-primary' : 'btn-ghost'}`}
              style="width: 100%;"
              href={plan.cta.href}
            >
              {plan.cta.label}
            </a>
          </article>
        ))
      }
    </div>
    <p class="pricing-note">{s.pricing.note}</p>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section section--tight" id="faq" data-reveal>
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">{s.faq.eyebrow}</p>
      <h2 class="h-section">{s.faq.title}</h2>
    </div>
    <div class="faq" data-stagger>
      {
        s.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<CtaBand
  title={s.cta.title}
  lead={s.cta.lead}
  btn={{ label: s.cta.btnLabel, href: s.cta.btnHref }}
/>
