---
// Página 404 estática (se sirve para cualquier URL no encontrada).
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import Icon from '../components/Icon.astro';
---

<BaseLayout lang="es" title="404 — Pixel Web">
  <!-- Ajusta idioma y textos según la URL (/en → inglés) -->
  <script is:inline>
    (function () {
      var isEn = /^\/en\b/.test(window.location.pathname);
      document.documentElement.lang = isEn ? 'en' : 'es';
      document.title = isEn
        ? '404 — Page not found · Pixel Web'
        : '404 — Página no encontrada · Pixel Web';
      document.querySelectorAll('[data-es]').forEach(function (el) {
        el.textContent = isEn ? el.getAttribute('data-en') : el.getAttribute('data-es');
      });
      var sw = document.getElementById('switch-lang');
      var swl = document.getElementById('switch-lang-label');
      if (sw) sw.href = isEn ? '/' : '/en';
      if (swl) swl.textContent = isEn ? 'Español' : 'English';
    })();
  </script>

  <section class="section" style="min-height: 62vh; display: grid; place-items: center;">
    <div class="container" style="text-align: center; max-width: 600px;">
      <p class="h-display text-gradient" style="font-size: clamp(4rem, 12vw, 7rem); line-height: 1;">404</p>
      <h1 class="h-sub" style="margin-top: 8px;" data-es="Página no encontrada" data-en="Page not found">Página no encontrada</h1>
      <p class="text-muted" style="margin-top: 6px; font-size: 0.95rem;" data-es="La página que buscas no existe o se movió." data-en="The page you are looking for does not exist or has moved.">La página que buscas no existe o se movió.</p>
      <p class="lead" style="margin: 18px auto 0;">
        {t('es', 'nav.home')} · {t('es', 'nav.services')} · {t('es', 'nav.about')} ·{' '}
        {t('es', 'nav.blog')} · {t('es', 'nav.contact')}
      </p>
      <div class="btn-row" style="justify-content: center; margin-top: 30px;">
        <a class="btn btn-primary" href="/">
          {t('es', 'nav.home')}
          <Icon name="arrowRight" />
        </a>
        <a id="switch-lang" class="btn btn-ghost" href="/en">
          <span id="switch-lang-label">English</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
