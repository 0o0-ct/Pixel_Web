---
/**
 * Página de inicio — se ensambla desde el diccionario de contenido.
 * Se renderiza para / (es) y /en (en) mediante envoltorios en pages/.
 */
import type { Lang } from '../../i18n/ui';
import { t } from '../../i18n/ui';
import { contentFor } from '../../data';
import type { Feature, Project, Step } from '../../data';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import cvsj from '../../gallery/cvsj.webp';

interface Props {
  lang: Lang;
}

/** Miniaturas reales del showcase, indexadas por la clave `image` de cada proyecto. */
const PROJECT_IMAGES: Record<string, ImageMetadata> = { cvsj };

const { lang } = Astro.props;
const home = contentFor(lang).home;
const SHARE_TITLE = t(lang, 'site.name');
---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="container hero__grid">
    <div>
      <p class="eyebrow hero__eyebrow">{home.hero.eyebrow}</p>
      <h1 class="h-display hero__title">
        {home.hero.titlePre}<span class="text-gradient">{home.hero.titleGrad}</span
        >{home.hero.titlePost}
      </h1>
      <p class="lead hero__lead">{home.hero.lead}</p>
      <div class="hero__cta">
        <a class="btn btn-primary" href={home.hero.ctaPrimary.href}>
          {home.hero.ctaPrimary.label}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn-ghost" href={home.hero.ctaSecondary.href}>
          {home.hero.ctaSecondary.label}
        </a>
      </div>
      <p class="hero__hint mono">{home.hero.hint}</p>
    </div>

    <div class="hero__visual" data-hero-visual>
      <span class="hero__orb orb-1"></span>
      <span class="hero__orb orb-2"></span>

      <div class="browser" aria-hidden="true" data-hero-browser>
        <div class="browser__bar">
          <div class="browser__dots">
            <i></i><i></i><i></i>
          </div>
          <div class="browser__url">{SHARE_TITLE.toLowerCase()}.dev</div>
        </div>
        <div class="browser__body">
          <div class="mini-nav">
            <span></span><span></span><span></span>
          </div>
          <div class="mini-hero">
            <span class="mini-kicker">{home.hero.eyebrow}</span>
            <span class="mini-title">{home.hero.miniTitle}</span>
            <div class="mini-lines">
              <p></p>
              <p></p>
              <p></p>
            </div>
            <div class="mini-actions">
              <span class="mini-btn"></span>
              <span class="mini-btn mini-btn--ghost"></span>
            </div>
          </div>
          <div class="mini-chart" aria-hidden="true">
            <i style="height: 34%"></i>
            <i style="height: 48%"></i>
            <i style="height: 40%"></i>
            <i style="height: 64%"></i>
            <i style="height: 58%"></i>
            <i style="height: 78%"></i>
            <i style="height: 92%"></i>
          </div>
        </div>
      </div>

      <div class="float-card float-card--a" data-hero-float-a>
        <span class="dot dot--live"></span>
        <div>
          <strong>{home.hero.floatA.title}</strong>
          <div class="text-faint mono" style="font-size: 0.78rem;">{home.hero.floatA.sub}</div>
        </div>
      </div>
      <div class="float-card float-card--b" data-hero-float-b>
        <Icon name="trending" style="color: var(--cyan)" />
        <div>
          <strong>{home.hero.floatB.title}</strong>
          <div class="text-faint" style="font-size: 0.78rem;">{home.hero.floatB.sub}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, spring } from 'motion';

  // Framer Motion: Movimiento 3D Tilt y Parallax al pasar el scroll / cursor sobre el cuadro héroe
  if (typeof window !== 'undefined') {
    const initHeroMotion = () => {
      const container = document.querySelector<HTMLElement>('[data-hero-visual]');
      const browser = document.querySelector<HTMLElement>('[data-hero-browser]');
      const floatA = document.querySelector<HTMLElement>('[data-hero-float-a]');
      const floatB = document.querySelector<HTMLElement>('[data-hero-float-b]');

      if (!container || !browser) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;

      // 1. Movimiento 3D Tilt interactivo con física de resorte (spring)
      container.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = container.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;

        // Inclinación 3D del cuadro del navegador (browser)
        animate(
          browser,
          {
            transform: `perspective(1000px) rotateX(${-y * 14}deg) rotateY(${x * 14}deg) translateY(-8px) scale(1.02)`
          },
          { duration: 0.4, easing: spring({ stiffness: 250, damping: 20 }) }
        );

        // Movimiento desfasado en 3D para las tarjetas flotantes
        if (floatA) {
          animate(
            floatA,
            {
              transform: `translate3d(${x * -25}px, ${y * -25 - 6}px, 20px) scale(1.04)`
            },
            { duration: 0.45, easing: spring({ stiffness: 220, damping: 18 }) }
          );
        }

        if (floatB) {
          animate(
            floatB,
            {
              transform: `translate3d(${x * 30}px, ${y * 30 + 6}px, 30px) scale(1.05)`
            },
            { duration: 0.5, easing: spring({ stiffness: 200, damping: 16 }) }
          );
        }
      });

      // Restablecer posición suave al salir el puntero
      container.addEventListener('mouseleave', () => {
        animate(
          browser,
          { transform: 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px) scale(1)' },
          { duration: 0.6, easing: spring({ stiffness: 180, damping: 20 }) }
        );

        if (floatA) {
          animate(
            floatA,
            { transform: 'translate3d(0px, 0px, 0px) scale(1)' },
            { duration: 0.6, easing: spring({ stiffness: 180, damping: 20 }) }
          );
        }

        if (floatB) {
          animate(
            floatB,
            { transform: 'translate3d(0px, 0px, 0px) scale(1)' },
            { duration: 0.6, easing: spring({ stiffness: 180, damping: 20 }) }
          );
        }
      });

      // 2. Parallax continuo de scroll sobre la sección héroe
      window.addEventListener(
        'scroll',
        () => {
          const scrollY = window.scrollY;
          if (scrollY < 900) {
            const shiftY = scrollY * 0.08;
            container.style.setProperty('--scroll-parallax', `${shiftY}px`);
          }
        },
        { passive: true }
      );
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroMotion);
    } else {
      initHeroMotion();
    }
  }
</script>

<!-- ============ FRANJA DE ESTADÍSTICAS EN MOVIMIENTO ============ -->
<section class="marquee stats-marquee" aria-label={home.stats.eyebrow}>
  <div class="marquee__track">
    {
      [0, 1, 2, 3, 4, 5, 6, 7].map((i) =>
        home.stats.items.map((s) => (
          <div
            class="marquee__item marquee__item--stat"
            aria-hidden={i > 0 ? 'true' : undefined}
          >
            <span class="marquee__value text-gradient">{s.value}</span>
            <span class="marquee__label">{s.label}</span>
          </div>
        )),
      )
    }
  </div>
</section>

<!-- ============ SHOWCASE EN VIVO ============ -->
<section class="section" id="showcase" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{home.showcase.eyebrow}</p>
      <h2 class="h-section">{home.showcase.title}</h2>
      <p class="lead" style="margin-top: 16px;">{home.showcase.lead}</p>
    </div>

    <div class="project-grid" data-stagger>
      {
        home.showcase.items.map((p: Project) => {
          const img = p.image ? PROJECT_IMAGES[p.image] : undefined;
          return (
            <article class="project-card">
              <a
                class="project-card__shot"
                style={`background: ${p.theme};`}
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${p.name} — ${p.desc}`}
              >
                {img ? (
                  <Image
                    src={img}
                    alt={p.name}
                    loading="lazy"
                    width={1200}
                    height={750}
                  />
                ) : (
                  <span class="project-card__name">{p.name}</span>
                )}
              </a>
              <div class="project-card__meta">
                <div class="project-card__info">
                  <h3 class="project-card__title">{p.name}</h3>
                  <a
                    class="project-card__link"
                    href={p.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {home.showcase.visitLabel}
                    <Icon name="external" />
                  </a>
                </div>
                <div class="project-card__tags">
                  <span class="chip chip--accent">
                    <span class="dot dot--live"></span>
                    {home.showcase.liveLabel}
                  </span>
                  {p.tags.map((tag) => <span class="chip">{tag}</span>)}
                </div>
              </div>
            </article>
          );
        })
      }

      <!-- Tarjeta fantasma: tu próximo proyecto -->
      <a class="project-card project-card--ghost" href={home.showcase.ghost.href}>
        <div>
          <Icon name="sparkle" style="width: 34px; height: 34px; color: var(--cyan); margin: 0 auto 14px; display: block;" />
          <h3 class="h-sub" style="color: var(--text);">{home.showcase.ghost.title}</h3>
          <p style="max-width: 30ch; margin: 10px auto 0;">{home.showcase.ghost.desc}</p>
          <span class="link-arrow" style="justify-content: center; margin-top: 18px;">
            {home.showcase.ghost.cta}
            <Icon name="arrowRight" />
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ============ SERVICIOS DESTACADOS ============ -->
<section class="section" id="servicios" data-reveal>
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">{home.services.eyebrow}</p>
      <h2 class="h-section">{home.services.title}</h2>
      <p class="lead" style="margin: 16px auto 0;">{home.services.lead}</p>
    </div>

    <div class="grid-features" data-stagger>
      {
        home.services.items.map((f: Feature) => (
          <article class="card">
            <span class="card__glow"></span>
            <div class="feature-icon">
              <Icon name={f.icon} style="color: var(--violet)" />
            </div>
            <h3 class="h-sub" style="font-size: 1.2rem;">{f.title}</h3>
            <p class="text-muted" style="margin-top: 10px; font-size: 0.97rem;">{f.desc}</p>
            <a class="link-arrow" href={f.href} aria-label={f.title}>
              <Icon name="arrowRight" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ============ PROCESO ============ -->
<section class="section section--tight">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{home.process.eyebrow}</p>
      <h2 class="h-section">{home.process.title}</h2>
      <p class="lead" style="margin-top: 16px;">{home.process.lead}</p>
    </div>

    <div class="grid-process" data-stagger>
      {
        home.process.steps.map((s: Step) => (
          <div class="card">
            <span class="step-num">{s.num}</span>
            <h3 style="font-size: 1.1rem;">{s.title}</h3>
            <p class="text-muted" style="margin-top: 10px; font-size: 0.95rem;">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ============ CITA ============ -->
<section class="section section--tight">
  <div class="container">
    <figure class="quote" data-reveal="blur">
      <span class="quote__mark">“</span>
      <blockquote>{home.quote.text}</blockquote>
      <figcaption>
        <strong>{home.quote.author}</strong>
        {home.quote.role}
      </figcaption>
    </figure>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="section section--tight">
  <div class="container">
    <div class="cta-band" data-reveal="scale">
      <h2 class="h-section">{home.cta.title}</h2>
      <p class="lead">{home.cta.lead}</p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn-primary" href={home.cta.btnPrimary.href}>
          {home.cta.btnPrimary.label}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn-ghost" href={home.cta.btnSecondary.href}>
          {home.cta.btnSecondary.label}
        </a>
      </div>
    </div>
  </div>
</section>
