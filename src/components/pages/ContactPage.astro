---
/**
 * Página de Contacto — canales + formulario (mailto mejorado con JS).
 * Ruta: /contacto y /en/contact.
 */
import type { Lang } from '../../i18n/ui';
import { contentFor, CONTACT } from '../../data';
import Icon from '../Icon.astro';
import CustomSelect from '../CustomSelect.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ct = contentFor(lang).contact;
const l = ct.form.labels;
const mailtoBase = `mailto:${CONTACT.email}`;


// En SSG, el parámetro `tipo` de la URL se procesa dinámicamente en el cliente
---

<section class="section section--tight contact-section" data-reveal>
  <div class="container">
    <p class="eyebrow">{ct.page.eyebrow}</p>
    <div class="split split--form" data-stagger>
      <!-- Columna izquierda: título de la página + canales -->
      <div>
        <h1 class="h-display contact-title">{ct.page.title}</h1>
        <p class="lead contact-lead">{ct.page.lead}</p>

        <div class="contact-channels">
          <p class="eyebrow">{ct.channels.eyebrow}</p>
          <h2 class="h-sub">{ct.channels.title}</h2>
          <div class="contact-list">
            {
              ct.channels.items.map((ch) => (
                <div class="contact-item">
                  <div class="contact-item__icon">
                    <Icon name={ch.icon} style="color: var(--violet)" />
                  </div>
                  <div>
                    <h3>{ch.title}</h3>
                    {ch.href ? <a href={ch.href}>{ch.text}</a> : <p>{ch.text}</p>}
                    <span class="mono text-faint" style="font-size: 0.8rem;">{ch.hint}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Formulario -->
      <div class="card" style="padding: clamp(24px, 3vw, 36px); overflow: visible; z-index: 10;">
        <p class="eyebrow">{ct.form.eyebrow}</p>
        <h2 class="h-sub" style="font-size: 1.5rem;">{ct.form.title}</h2>
        <p class="text-muted" style="margin-top: 8px; font-size: 0.95rem;">{ct.form.lead}</p>

        <!-- Banner reactivo: servicio seleccionado desde Servicios -->
        <div
          id="selected-service-banner"
          class="selected-service-banner"
          style="display: none;"
          role="status"
          aria-live="polite"
        >
          <div class="selected-service-banner__content">
            <span class="selected-service-banner__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </span>
            <div class="selected-service-banner__info">
              <span class="selected-service-banner__label">
                {lang === 'es' ? 'Servicio seleccionado:' : 'Selected service:'}
              </span>
              <strong id="selected-service-name" class="selected-service-banner__name"></strong>
            </div>
          </div>
          <button
            type="button"
            id="selected-service-clear"
            class="selected-service-banner__clear"
            title={lang === 'es' ? 'Cambiar selección' : 'Change selection'}
            aria-label={lang === 'es' ? 'Cambiar selección' : 'Change selection'}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <form id="contact-form" data-mailto={mailtoBase} style="margin-top: 26px;">
          <div class="form-grid">
            <div class="field">
              <label for="cf-name">{l.name}</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" placeholder={l.namePh} required />
            </div>
            <div class="field">
              <label for="cf-email">{l.email}</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" placeholder={l.emailPh} required />
            </div>
            <CustomSelect
              id="cf-type"
              name="type"
              label={l.type}
              placeholder={l.typePh}
              options={ct.form.types}
              required
            />
            <CustomSelect
              id="cf-budget"
              name="budget"
              label={l.budget}
              placeholder={l.budgetPh}
              options={ct.form.budgets}
            />
            <div class="field field--full">
              <label for="cf-message">{l.message}</label>
              <textarea id="cf-message" name="message" placeholder={l.messagePh} required></textarea>
            </div>
          </div>

          <p class="notice" id="cf-success" role="status" aria-live="polite" tabindex="-1" hidden>
            <Icon name="check" />
            <span>{ct.form.success}</span>
          </p>

          <button class="btn btn-primary" type="submit" style="width: 100%; margin-top: 22px;">
            {l.submit}
            <Icon name="arrowRight" />
          </button>
          <p class="text-faint" style="font-size: 0.8rem; margin-top: 14px; text-align: center;">
            {l.privacy}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ lName: l.name, lEmail: l.email, lType: l.type, lBudget: l.budget, formTypes: ct.form.types }}>
  (function () {
    const banner = document.getElementById('selected-service-banner');
    const bannerName = document.getElementById('selected-service-name');
    const clearBtn = document.getElementById('selected-service-clear');
    const typeInput = document.getElementById('cf-type');
    const typeRoot = typeInput ? typeInput.closest('[data-cselect]') : null;

    function getLabelFor(val) {
      if (!val) return '';
      const found = formTypes.find((t) => t.value === val);
      return found ? found.label : val;
    }

    function updateBanner(label) {
      if (!banner || !bannerName) return;
      if (label) {
        bannerName.textContent = label;
        banner.style.display = 'flex';
      } else {
        banner.style.display = 'none';
      }
    }

    // Escucha cambios del desplegable
    if (typeRoot) {
      typeRoot.addEventListener('cselect:change', (e) => {
        const detail = e.detail;
        const label = detail && detail.value ? (detail.label || getLabelFor(detail.value)) : '';
        updateBanner(label);
      });
    }

    // Botón para limpiar o cambiar la selección
    if (clearBtn && typeRoot) {
      clearBtn.addEventListener('click', () => {
        if (typeof typeRoot.cselectSet === 'function') {
          typeRoot.cselectSet('');
        }
        updateBanner('');
      });
    }

    // Sincronizar al cargar la página
    function syncInitial() {
      if (typeRoot) {
        const input = typeRoot.querySelector('[data-cselect-input]');
        const val = input ? input.value : '';
        if (val) {
          const label = getLabelFor(val);
          updateBanner(label);
        }
      }
    }

    syncInitial();
    setTimeout(syncInitial, 80);
  })();

  const form = document.querySelector('#contact-form');
  const success = document.querySelector('#cf-success');
  if (form && success) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const rawType = String(data.get('type') ?? '');
      const matched = formTypes.find((t) => t.value === rawType);
      const typeDisplay = matched ? matched.label : rawType;

      const subject = encodeURIComponent(
        `[Design Web] ${typeDisplay} — ${String(data.get('name') ?? '')}`,
      );
      const lines = [
        `${lName}: ${String(data.get('name') ?? '')}`,
        `${lEmail}: ${String(data.get('email') ?? '')}`,
        `${lType}: ${typeDisplay}`,
        `${lBudget}: ${String(data.get('budget') ?? '')}`,
        '',
        String(data.get('message') ?? ''),
      ];
      const body = encodeURIComponent(lines.join('\n'));
      window.location.href = `${form.dataset.mailto}?subject=${subject}&body=${body}`;
      success.hidden = false;
      success.focus();
    });
  }
</script>
